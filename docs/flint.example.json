{
  "listen": ":8443",
  "dataDir": "/var/lib/flint",
  "tls": {
    "certFile": "/etc/flint/tls/tls.crt",
    "keyFile": "/etc/flint/tls/tls.key"
  },
  "trustedProxies": ["10.42.0.0/16", "192.168.1.10"],
  "shutdownTimeout": "25s",
  "log": {
    "level": "info"
  },
  "repositories": [
    {
      "name": "docker-local",
      "format": "oci",
      "type": "hosted"
    },
    {
      "name": "releases",
      "format": "oci",
      "type": "hosted",
      "immutableTags": true,
      "anonymousPull": true
    },
    {
      "name": "dockerhub",
      "format": "oci",
      "type": "proxy",
      "proxy": {
        "url": "https://registry-1.docker.io",
        "username": "flint-mirror",
        "passwordFile": "/etc/flint/upstream/dockerhub/password",
        "revalidateAfter": "5m"
      }
    },
    {
      "name": "ghcr",
      "format": "oci",
      "type": "proxy",
      "proxy": {
        "url": "https://ghcr.io",
        "sizeLimit": "200GiB"
      }
    }
  ],
  "proxyCache": {
    "minFreeSpace": "5%"
  },
  "backup": {
    "directory": "/var/backups/flint"
  },
  "auth": {
    "bootstrapAdmin": {
      "username": "admin",
      "passwordFile": "/etc/flint/admin/password"
    },
    "permissions": [
      {
        "repositories": ["docker-local", "releases"],
        "role": "write",
        "groups": ["ci"]
      },
      {
        "repositories": ["dockerhub", "ghcr"],
        "role": "read",
        "groups": ["ci"]
      },
      {
        "repositories": ["team-a-*"],
        "role": "admin",
        "users": ["alice"]
      }
    ]
  }
}
