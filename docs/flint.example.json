{
  "listen": ":8443",
  "dataDir": "/var/lib/flint",
  "publicURL": "https://flint.example.com",
  "tls": {
    "certFile": "/etc/flint/tls/tls.crt",
    "keyFile": "/etc/flint/tls/tls.key"
  },
  "trustedProxies": ["10.42.0.0/16", "192.168.1.10"],
  "shutdownTimeout": "25s",
  "log": {
    "level": "info"
  },
  "repositories": [
    {
      "name": "docker-local",
      "format": "oci",
      "type": "hosted"
    },
    {
      "name": "releases",
      "format": "oci",
      "type": "hosted",
      "immutableTags": true,
      "anonymousPull": true,
      "helmIndex": true
    },
    {
      "name": "dockerhub",
      "format": "oci",
      "type": "proxy",
      "proxy": {
        "url": "https://registry-1.docker.io",
        "username": "flint-mirror",
        "passwordFile": "/etc/flint/upstream/dockerhub/password",
        "revalidateAfter": "5m"
      }
    },
    {
      "name": "ghcr",
      "format": "oci",
      "type": "proxy",
      "proxy": {
        "url": "https://ghcr.io",
        "sizeLimit": "200GiB"
      }
    },
    {
      "name": "pypi-local",
      "format": "pypi",
      "type": "hosted"
    },
    {
      "name": "pypi",
      "format": "pypi",
      "type": "proxy",
      "proxy": {
        "url": "https://pypi.org/simple/",
        "revalidateAfter": "10m"
      }
    },
    {
      "name": "pypi-all",
      "format": "pypi",
      "type": "virtual",
      "anonymousPull": true,
      "virtual": {
        "members": [
          "pypi-local",
          {"name": "pypi", "exclude": ["acme-*"]}
        ],
        "publishTo": "pypi-local"
      }
    },
    {
      "name": "files",
      "format": "generic",
      "type": "hosted"
    },
    {
      "name": "tool-releases",
      "format": "generic",
      "type": "proxy",
      "generic": {
        "immutable": true
      },
      "proxy": {
        "url": "https://github.com/acme/tool/releases/download/",
        "allowHosts": ["release-assets.githubusercontent.com", "objects.githubusercontent.com"]
      }
    },
    {
      "name": "cargo-local",
      "format": "cargo",
      "type": "hosted"
    },
    {
      "name": "crates-io",
      "format": "cargo",
      "type": "proxy",
      "proxy": {
        "url": "sparse+https://index.crates.io/"
      }
    },
    {
      "name": "cargo-all",
      "format": "cargo",
      "type": "virtual",
      "virtual": {
        "members": [
          "cargo-local",
          {"name": "crates-io", "exclude": ["acme-*"]}
        ],
        "publishTo": "cargo-local"
      }
    },
    {
      "name": "npm-local",
      "format": "npm",
      "type": "hosted"
    },
    {
      "name": "goproxy",
      "format": "go",
      "type": "proxy",
      "proxy": {
        "url": "https://proxy.golang.org"
      }
    },
    {
      "name": "go-corp",
      "format": "go",
      "type": "proxy",
      "proxy": {
        "url": "https://goproxy.corp.example.com",
        "username": "flint",
        "passwordFile": "/etc/flint/upstream/go-corp/password"
      },
      "go": {
        "noSumCheck": ["corp.example.com/*"]
      }
    },
    {
      "name": "go-all",
      "format": "go",
      "type": "virtual",
      "virtual": {
        "members": [
          {"name": "go-corp", "include": ["corp.example.com/*"]},
          {"name": "goproxy", "exclude": ["corp.example.com/*"]}
        ]
      }
    },
    {
      "name": "docker",
      "format": "oci",
      "type": "virtual",
      "virtual": {
        "members": ["docker-local", "dockerhub", "ghcr"],
        "publishTo": "docker-local"
      }
    }
  ],
  "proxyCache": {
    "minFreeSpace": "5%"
  },
  "backup": {
    "directory": "/var/backups/flint"
  },
  "gc": {
    "gracePeriod": "24h",
    "interval": "24h"
  },
  "audit": {
    "retention": {
      "maxAge": "17520h"
    }
  },
  "auth": {
    "bootstrapAdmin": {
      "username": "admin",
      "passwordFile": "/etc/flint/admin/password"
    },
    "permissions": [
      {
        "repositories": ["docker-local", "releases", "pypi-local", "files", "cargo-local", "npm-local"],
        "role": "write",
        "groups": ["ci"]
      },
      {
        "repositories": ["dockerhub", "ghcr", "docker", "pypi", "crates-io", "cargo-all", "go-all"],
        "role": "read",
        "groups": ["ci"]
      },
      {
        "repositories": ["team-a-*"],
        "role": "admin",
        "users": ["alice"]
      }
    ]
  }
}
