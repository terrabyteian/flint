{
  "listen": ":8443",
  "dataDir": "/var/lib/flint",
  "tls": {
    "certFile": "/etc/flint/tls/tls.crt",
    "keyFile": "/etc/flint/tls/tls.key"
  },
  "trustedProxies": ["10.42.0.0/16", "192.168.1.10"],
  "shutdownTimeout": "25s",
  "log": {
    "level": "info"
  },
  "repositories": [
    {
      "name": "docker-local",
      "format": "oci",
      "type": "hosted"
    },
    {
      "name": "releases",
      "format": "oci",
      "type": "hosted",
      "immutableTags": true,
      "anonymousPull": true,
      "helmIndex": true
    },
    {
      "name": "dockerhub",
      "format": "oci",
      "type": "proxy",
      "proxy": {
        "url": "https://registry-1.docker.io",
        "username": "flint-mirror",
        "passwordFile": "/etc/flint/upstream/dockerhub/password",
        "revalidateAfter": "5m"
      }
    },
    {
      "name": "ghcr",
      "format": "oci",
      "type": "proxy",
      "proxy": {
        "url": "https://ghcr.io",
        "sizeLimit": "200GiB"
      }
    },
    {
      "name": "pypi-local",
      "format": "pypi",
      "type": "hosted"
    },
    {
      "name": "pypi",
      "format": "pypi",
      "type": "proxy",
      "proxy": {
        "url": "https://pypi.org/simple/",
        "revalidateAfter": "10m"
      }
    },
    {
      "name": "pypi-all",
      "format": "pypi",
      "type": "virtual",
      "anonymousPull": true,
      "virtual": {
        "members": ["pypi-local", "pypi"]
      }
    }
  ],
  "proxyCache": {
    "minFreeSpace": "5%"
  },
  "backup": {
    "directory": "/var/backups/flint"
  },
  "gc": {
    "gracePeriod": "24h",
    "interval": "24h"
  },
  "audit": {
    "retention": {
      "maxAge": "17520h"
    }
  },
  "auth": {
    "bootstrapAdmin": {
      "username": "admin",
      "passwordFile": "/etc/flint/admin/password"
    },
    "permissions": [
      {
        "repositories": ["docker-local", "releases", "pypi-local"],
        "role": "write",
        "groups": ["ci"]
      },
      {
        "repositories": ["dockerhub", "ghcr", "pypi"],
        "role": "read",
        "groups": ["ci"]
      },
      {
        "repositories": ["team-a-*"],
        "role": "admin",
        "users": ["alice"]
      }
    ]
  }
}
